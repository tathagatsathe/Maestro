ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
TAVILY_API_KEY=your_tavily_api_key_here
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+asyncpg://agent:agentpass@localhost:5432/agentdb
API_KEY=dev-api-key-change-me
RATE_LIMIT_RUNS_PER_MINUTE=10

# LangSmith tracing (https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=maestro
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Cost estimation (USD per million tokens, approximate)
LLM_INPUT_COST_PER_MILLION=3.0
LLM_OUTPUT_COST_PER_MILLION=15.0
